# ==========================================
# BP TECH INVENTORY MANAGEMENT SYSTEM - ENV
# ==========================================

# PostgreSQL Connection String (or SQLite for local fallback)
# Format for PostgreSQL: postgresql://username:password@localhost:5432/bp_tech_db
# For SQLite (instant local dev): sqlite:///./bp_tech.db
DATABASE_URL=sqlite:///./bp_tech.db

# JWT & Authentication Secret
SECRET_KEY=bp_tech_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Administrator Default Account (created by seed script)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@bptech.com

# BP Tech WhatsApp Contact (Malaysia country code e.g. 60123456789)
WHATSAPP_PHONE_NUMBER=60123456789

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
